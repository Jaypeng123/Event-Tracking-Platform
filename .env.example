# Optional platform fallback for reading Figma files and pages.
FIGMA_ACCESS_TOKEN=

# Figma OAuth flow for users to authorize their own files.
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_COOKIE_SECRET=
FIGMA_OAUTH_REDIRECT_URI=
FIGMA_OAUTH_SCOPES=file_content:read
FIGMA_OAUTH_ENABLED=true

# Required when the app is set to OpenAI models.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional fallback provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
